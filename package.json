{
  "name": "dsh-inline-quote",
  "version": "0.1.0",
  "description": "Inline quoted excerpts as native DSH composer reference chips",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "quote",
    "inline-quote",
    "reference-chip",
    "cordis"
  ],
  "license": "MIT",
  "author": "anqifox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anqifox/dsh-inline-quote.git"
  },
  "homepage": "https://github.com/anqifox/dsh-inline-quote#readme",
  "bugs": {
    "url": "https://github.com/anqifox/dsh-inline-quote/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  }
}
